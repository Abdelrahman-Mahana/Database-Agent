    # Database
    # DATABASE_URL=sqlite:///./sample.db

    # LLM Provider (groq | openai | openrouter | ollama)
    LLM_PROVIDER=groq

    # Groq Configuration
    GROQ_API_KEY=
    GROQ_MODEL=openai/gpt-oss-120b
    GROQ_FAST_MODEL=openai/gpt-oss-20b
    GROQ_BASE_URL=https://api.groq.com/openai/v1

    # OpenAI Configuration
    OPENAI_API_KEY=
    OPENAI_MODEL=gpt-4o
    OPENAI_FAST_MODEL=gpt-4o-mini
    OPENAI_BASE_URL=https://api.openai.com/v1

    # OpenRouter Configuration
    OPENROUTER_API_KEY=
    OPENROUTER_MODEL=google/gemini-2.5-flash
    OPENROUTER_FAST_MODEL=google/gemini-2.5-flash
    OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

    # Ollama Configuration
    OLLAMA_BASE_URL=http://localhost:11434
    OLLAMA_MODEL=gemma3:4b
    OLLAMA_FAST_MODEL=gemma3:4b

    # Self-Consistency & Optimization
    SQL_CANDIDATES=2
    ENABLE_SELF_CONSISTENCY=false
    ENABLE_REPORT_VERIFICATION=false
    ENABLE_CHART_SUGGESTION=true

    USE_LLM_UNDERSTANDING=true
    USE_LANGGRAPH_ORCHESTRATOR=false


    # route simple questions to the cheap model
    ENABLE_MODEL_ROUTING=true


    # API
    API_HOST=0.0.0.0
    API_PORT=8000
    DEBUG=true
