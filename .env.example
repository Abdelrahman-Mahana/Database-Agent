    # Database
    # DATABASE_URL=sqlite:///./sample.db

    # LLM Provider (Groq native API)
    LLM_PROVIDER=groq

    # Groq Configuration
    GROQ_API_KEY=
    GROQ_MODEL=llama-3.3-70b-versatile
    GROQ_FAST_MODEL=llama-3.1-8b-instant
    GROQ_BASE_URL=https://api.groq.com/openai/v1

    # Self-Consistency & Optimization
    SQL_CANDIDATES=2
    ENABLE_SELF_CONSISTENCY=false
    ENABLE_REPORT_VERIFICATION=false
    ENABLE_CHART_SUGGESTION=true

    USE_LLM_UNDERSTANDING=true
    USE_LANGGRAPH_ORCHESTRATOR=true


    # route simple questions to the cheap model
    ENABLE_MODEL_ROUTING=true


    # API
    API_HOST=0.0.0.0
    API_PORT=8000
    DEBUG=true
